            <script>
             var base_url = 'https://punjablaws.punjab.gov.pk/';
             var article_id = "7230";
             var article_files_url = 'https://punjablaws.punjab.gov.pk/uploads/articles';
             $('.paginate_button').click(function() {
              $('.artlist').css({
               position: 'fixed',
               top: 0,
               right: 0,
               bottom: 0,
               left: 0,
               zIndex: 999
             });
            });


             function get_article_file(object)
             {
              var selected_article_id = $(object).attr('id');
                // alert(selected_article_id);
                var selected_article_cls = $(object).attr('class');
                // alert(selected_article_cls);
                $.ajax({
                 url: base_url +'en/get_selected_article',
                 data: {'article_id_encoded':selected_article_id},
                 type: 'POST',
                 dataType: 'json',
                 success: function (data) 
                 {
                  if (data.status == 'success') 
                  {

                   var article_data = data.article;
                    console.log(article_data);

                   $('#'+selected_article_cls+'_pdf_view').css('display','block');
                   $('.'+selected_article_cls+'_obj').attr('data',article_files_url+'/'+article_data.article_pdf_file);
                   $('.'+selected_article_cls+'_obj').attr('title',article_files_url+'/'+article_data.article_title_english);

                   $('.'+selected_article_cls+'_emb').attr('src',article_files_url+'/'+article_data.article_pdf_file);
                   $('.'+selected_article_cls+'_emb').attr('title',article_files_url+'/'+article_data.article_title_english);

                   $('#'+selected_article_cls+'_btns').css('display','block');
                   $('#'+selected_article_cls+'_download').attr('href',article_files_url+'/'+article_data.article_pdf_file);
                   $('.'+selected_article_cls+'_feedback').attr('id',article_data.article_id);

					$('html, body').animate({
						scrollTop: $('#'+selected_article_cls+'_pdf_view').offset().top - 100
					}, 500);

                 }

               }
             });

              }

              function open_feedback(art_id)
              {
                window.open(base_url+'feedback/index/'+art_id,'name','height=700px,width=700px');

              }

              
            </script>


