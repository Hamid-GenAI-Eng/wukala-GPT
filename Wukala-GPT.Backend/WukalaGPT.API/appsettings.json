{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=WukalaGPT;Username=postgres;Password=YOUR_DATABASE_PASSWORD;Pooling=true;Maximum Pool Size=500;Minimum Pool Size=5;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_REPLACE_ME_IN_PRODUCTION",
    "Issuer": "WukalaGPT_API",
    "Audience": "WukalaGPT_Clients"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "FromEmail": "no-reply@wukala-gpt.app"
  },
  "OpenAI": {
    "ApiKey": "YOUR_API_KEY_HERE"
  }
}