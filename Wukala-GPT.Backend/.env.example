# .env Template for Wukala-GPT DigitalOcean App Platform Deployment
# DO NOT COMMIT THIS FILE WITH REAL VALUES TO SOURCE CONTROL.

# ----------------------------------------------------- #
# CORE ENVIRONMENT
# ----------------------------------------------------- #
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# ----------------------------------------------------- #
# DATABASE (PostgreSQL)
# Format: Host={IP_OR_MANAGED_DB_URL};Database=WukalaGPT;Username={USER};Password={PASSWORD};Pooling=true;Maximum Pool Size=500;Minimum Pool Size=5;
# Security Note: If using DO App Platform, this will likely be automatically injected as `DATABASE_URL` and you will need to map it, or directly inject this string.
# ----------------------------------------------------- #
ConnectionStrings__DefaultConnection=Host=wukala_postgres;Database=WukalaGPT;Username=postgres;Password=YOUR_SECURE_PASSWORD;Pooling=true;Maximum Pool Size=500;Minimum Pool Size=5;

# ----------------------------------------------------- #
# CACHE & MESSAGING (Redis)
# Security Note: MUST NOT BE EXPOSED TO PUBLIC INTERNET. Bind to DO Private VPC.
# ----------------------------------------------------- #
ConnectionStrings__Redis=wukala_redis:6379,abortConnect=false,password=YOUR_REDIS_PASSWORD_IF_ANY

# ----------------------------------------------------- #
# SECURITY (JWT / Auth)
# Generate a random 64-character string for production!
# ----------------------------------------------------- #
JwtSettings__Secret=YOUR_PROD_SUPER_SECRET_KEY_MUST_BE_LONG_ENOUGH
JwtSettings__Issuer=https://api.wukala-gpt.app
JwtSettings__Audience=https://wukala-gpt.app

# ----------------------------------------------------- #
# THIRD PARTY INTEGRATIONS
# ----------------------------------------------------- #
Cloudinary__CloudName=YOUR_CLOUDINARY_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET

Resend__ApiKey=YOUR_RESEND_API_KEY
Resend__FromEmail=no-reply@wukala-gpt.app

OpenAI__ApiKey=YOUR_OPENAI_API_KEY
